----------------------------------------------------------------
-- Sequential (alternating) magazine loading.
-- Adds a context-menu entry on magazines (in the player's own
-- inventory only) that loads rounds in a user-defined repeating
-- pattern, e.g. type1 (xN), type2 (xM), type3 (xK), ... then wraps
-- around until the magazine is full or ammo runs out.
--
-- Two loading modes, controlled by the MCM "instant_load" toggle:
--   * instant  - entire magazine is filled in one frame
--   * gradual  - one round per tick, with the vanilla Mags Redux
--                delay and "ammo_load" sound (default)
--
-- An optional "ignore_bad_ammo" toggle (default ON) hides ammo
-- with "_bad" / "_verybad" suffix from the UI and from the load
-- algorithm entirely.
--
-- Integrates with Anomaly Magazines Redux via its public API
-- (magazine_binder, magazines) - no monkey-patching.
----------------------------------------------------------------

-- Presets are persisted per save via save_state/load_state.
-- Shape:
--   presets[caliber] = { {ammo = "ammo_5.45x39_fmj", count = 3}, ... }
local presets = {}

--------------------------------------------------------------------
-- Preset storage ---------------------------------------------------
--------------------------------------------------------------------

function get_presets()
	return presets
end

function get_preset(caliber)
	return presets[caliber]
end

function has_preset(caliber)
	return presets[caliber] ~= nil and #presets[caliber] > 0
end

function save_preset(caliber, preset)
	if not caliber then return end
	if preset and #preset > 0 then
		presets[caliber] = preset
	else
		presets[caliber] = nil
	end
end

function reset_preset(caliber)
	if not caliber then return end
	presets[caliber] = nil
end

local function save_state(mdata)
	mdata.seqload_presets = presets
end

local function load_state(mdata)
	presets = mdata.seqload_presets or {}
end

--------------------------------------------------------------------
-- Caliber / ammo discovery ----------------------------------------
--------------------------------------------------------------------

-- Caliber aliases: merge technically-separate ammo groups into a single
-- caliber bucket. Keys are the RAW caliber token as it appears in the
-- ammo section name, values are the canonical caliber the token maps to.
--
-- Current entries:
--   12x76 -> 12x70   : 12-gauge magnum shells share the same magazines
--                       as standard 12x70 shells (zhekan, bull, dart are
--                       typically interchangeable with buckshot).
--   pkm   -> 7.62x54 : PKM/PKP belt boxes (ammo_pkm_100) use the same
--                       cartridge as SVD rifles and some mod weapons can
--                       accept both in the same magazine.
--
-- To merge a new caliber in the future, just add a single line here.
local CALIBER_ALIASES = {
	["12x76"] = "12x70",
	["pkm"]   = "7.62x54",
}

-- Raw caliber tokens in this set are NOT included in the default
-- alphabetical preset built for a magazine, even if the magazine
-- technically accepts them. The user can still add them manually
-- from the "Add ammo type" dropdown in the UI.
--
-- Rationale for "pkm":
--   For a hypothetical weapon that accepts both loose 7.62x54 rounds
--   and full PKM belts, the default behaviour should be "load loose
--   rounds alternately" - belts are opt-in. Defaults for plain SVD or
--   plain PKP stay correct either way, because their magazines simply
--   don't accept the other side.
local HIDDEN_FROM_DEFAULT = {
	["pkm"] = true,
}

-- Caliber tokens that are NOT firearm ammunition (devices, knives, etc.).
local EXCLUDED_CALIBERS = {
	["batteries"] = true,
	["binoc"]     = true,
	["dyno"]      = true,
	["knife"]     = true,
	["bolt"]      = true,
}

-- Extract caliber token without applying aliases.
-- Examples: ammo_5.45x39_fmj -> 5.45x39 ; ammo_12x70_buck -> 12x70 ;
-- ammo_gauss -> gauss ; ammo_pkm_100 -> pkm
local function extract_caliber_raw(ammo_section)
	if not ammo_section then return nil end
	local c = ammo_section:match("^ammo_(.-)_")
	if c and c ~= "" then return c end
	return ammo_section:match("^ammo_(.+)$")
end

-- Extract caliber token WITH alias applied. This is the caliber used
-- for UI grouping and preset storage keys.
function extract_caliber(ammo_section)
	local raw = extract_caliber_raw(ammo_section)
	if raw and CALIBER_ALIASES[raw] then
		return CALIBER_ALIASES[raw]
	end
	return raw
end

local function is_excluded_caliber(cal)
	return cal and EXCLUDED_CALIBERS[cal] == true
end

local function is_excluded_ammo(sec)
	if not sec then return true end
	local raw = extract_caliber_raw(sec)
	if raw and EXCLUDED_CALIBERS[raw] then return true end
	return false
end

-- Weapons whose ammo_class should never appear in the preset UI.
-- Match by section name only (not LTX fields like shell_bone = bolt).
local function is_excluded_weapon(sec)
	if not sec then return true end
	local s = sec:lower()
	if s:find("knife", 1, true) then return true end
	if s:find("binoc", 1, true) then return true end
	if s == "wpn_bolt" or s:match("^wpn_bolt_") then return true end
	if s:find("device", 1, true) then return true end
	local ammo_class = SYS_GetParam(0, sec, "ammo_class") or ""
	if ammo_class == "" then return true end
	return false
end

-- "Damaged" ammo in GAMMA is marked by a suffix on the section name.
function is_bad_ammo(sec)
	if not sec then return false end
	return sec:match("_bad$") ~= nil or sec:match("_verybad$") ~= nil
end

local function ignore_bad_enabled()
	return sequential_load_magazine_mcm and sequential_load_magazine_mcm.IGNORE_BAD
end

local function instant_enabled()
	return sequential_load_magazine_mcm and sequential_load_magazine_mcm.INSTANT_LOAD
end

-- "Show post-load summary tip" toggle (MCM tip_after_load). Default ON
-- if the MCM module hasn't loaded yet (e.g. very first frame).
local function tip_after_load_enabled()
	if not sequential_load_magazine_mcm then return true end
	return sequential_load_magazine_mcm.TIP_AFTER_LOAD ~= false
end

local caliber_cache = nil     -- sorted array of caliber strings
local ammo_by_caliber = nil   -- {caliber = sorted array of ammo sections}

local function split_csv(s)
	local out = {}
	if not s then return out end
	for token in string.gmatch(s, "([^,%s]+)") do
		table.insert(out, token)
	end
	return out
end

local function hide_single_caliber_enabled()
	if not sequential_load_magazine_mcm then return true end
	return sequential_load_magazine_mcm.HIDE_SINGLE_CALIBER ~= false
end

function reset_caliber_cache()
	caliber_cache = nil
	ammo_by_caliber = nil
end

local function add_ammo_to_index(tmp, ammo_sec)
	if is_excluded_ammo(ammo_sec) then return end
	local cal = extract_caliber(ammo_sec)
	if not cal or is_excluded_caliber(cal) then return end
	tmp[cal] = tmp[cal] or {}
	for _, a in ipairs(tmp[cal]) do
		if a == ammo_sec then return end
	end
	table.insert(tmp[cal], ammo_sec)
end

local function supplement_calibers_from_weapons(tmp)
	local all_wpn = GetItemList("wpn") or {}
	for sec, _ in pairs(all_wpn) do
		if not is_excluded_weapon(sec) then
			for _, ammo_sec in ipairs(split_csv(SYS_GetParam(0, sec, "ammo_class") or "")) do
				add_ammo_to_index(tmp, ammo_sec)
			end
		end
	end
end

local function build_caliber_index()
	-- Empty {} is truthy in Lua; use nil sentinel so a failed first build
	-- (binder not ready yet) can be retried later.
	if caliber_cache ~= nil then return end

	local tmp = {}

	-- Index every non-junk ammo section; do not require Mags basetype lookup
	-- (that gate emptied the UI when binder was late or incomplete).
	for sec, _ in pairs(GetItemList("ammo") or {}) do
		add_ammo_to_index(tmp, sec)
	end

	-- Also pull ammo_class from weapons (covers modded / odd entries).
	supplement_calibers_from_weapons(tmp)

	caliber_cache = {}
	ammo_by_caliber = {}
	for cal, ammos in pairs(tmp) do
		table.sort(ammos)
		ammo_by_caliber[cal] = ammos
		table.insert(caliber_cache, cal)
	end
	table.sort(caliber_cache)
end

local function filter_bad(list)
	if not ignore_bad_enabled() then return list end
	local out = {}
	for _, sec in ipairs(list) do
		if not is_bad_ammo(sec) then
			table.insert(out, sec)
		end
	end
	return out
end

function get_all_calibers()
	build_caliber_index()
	-- Binder / GetItemList may not be ready on the very first call.
	if caliber_cache ~= nil and #caliber_cache == 0 then
		caliber_cache = nil
		ammo_by_caliber = nil
		build_caliber_index()
	end
	local all = caliber_cache or {}
	if not hide_single_caliber_enabled() then
		return all
	end
	local out = {}
	for _, cal in ipairs(all) do
		if #filter_bad(ammo_by_caliber[cal] or {}) > 1 then
			table.insert(out, cal)
		end
	end
	-- Never return an empty dropdown when calibers exist but were all
	-- single-type (hide-single filter would hide everything).
	if #out == 0 and #all > 0 then
		return all
	end
	return out
end

function get_ammos_for_caliber(caliber)
	build_caliber_index()
	local list = (ammo_by_caliber and ammo_by_caliber[caliber]) or {}
	return filter_bad(list)
end

-- Return caliber token for a given magazine object (or nil).
function get_mag_caliber(mag)
	if not (magazine_binder and magazine_binder.is_magazine and magazine_binder.is_magazine(mag)) then
		return nil
	end
	local compat = magazine_binder.get_magazine_caliber(mag)
	if not compat or #compat == 0 then return nil end
	return extract_caliber(compat[1])
end

--------------------------------------------------------------------
-- Loading algorithm ------------------------------------------------
--------------------------------------------------------------------

-- Collect player-inventory ammo pools for requested ammo types.
-- Returns { ammo_section = { total = N, boxes = { obj, ... } } }.
local function collect_ammo_inventory(ammo_types)
	local result = {}
	for _, ammo in ipairs(ammo_types) do
		result[ammo] = {total = 0, boxes = {}}
	end
	db.actor:iterate_inventory(function(owner, item)
		local sec = item:section()
		local pool = result[sec]
		if pool then
			table.insert(pool.boxes, item)
			pool.total = pool.total + item:ammo_get_count()
		end
	end)
	return result
end

-- Take one round from a pool. Returns true if a round was taken.
local function take_one_round(pool)
	while #pool.boxes > 0 do
		local box = pool.boxes[1]
		local count = box:ammo_get_count()
		if count > 1 then
			box:ammo_set_count(count - 1)
			pool.total = pool.total - 1
			return true
		elseif count == 1 then
			alife_release_id(box:id())
			table.remove(pool.boxes, 1)
			pool.total = pool.total - 1
			return true
		else
			table.remove(pool.boxes, 1)
		end
	end
	return false
end

-- Build default preset from all ammo types the magazine accepts, alphabetical, 1 each.
-- Applies "ignore bad" filter if enabled. Skips ammo whose raw caliber
-- token is in HIDDEN_FROM_DEFAULT (e.g. pkm belts): those require
-- manual opt-in from the UI.
local function build_default_preset(mag)
	local compat = magazine_binder.get_magazine_caliber(mag) or {}
	local sorted = {}
	for _, ammo in ipairs(compat) do
		local raw_cal = extract_caliber_raw(ammo)
		local skip = (ignore_bad_enabled() and is_bad_ammo(ammo))
		           or (raw_cal and HIDDEN_FROM_DEFAULT[raw_cal])
		if not skip then
			table.insert(sorted, ammo)
		end
	end
	table.sort(sorted)
	local preset = {}
	for _, ammo in ipairs(sorted) do
		table.insert(preset, {ammo = ammo, count = 1})
	end
	return preset
end

-- Keep only preset entries whose ammo is actually accepted by this magazine
-- and (optionally) not marked as bad ammo.
local function filter_preset_for_mag(preset, mag)
	local compat_set = {}
	for _, ammo in ipairs(magazine_binder.get_magazine_caliber(mag) or {}) do
		compat_set[ammo] = true
	end
	local filtered = {}
	for _, e in ipairs(preset or {}) do
		local ok = e.ammo and compat_set[e.ammo] and (e.count or 1) > 0
		if ok and ignore_bad_enabled() and is_bad_ammo(e.ammo) then
			ok = false
		end
		if ok then
			table.insert(filtered, {ammo = e.ammo, count = e.count or 1})
		end
	end
	return filtered
end

-- Expand preset into a flat cycle: [{A,3},{B,1}] -> {A,A,A,B}
function expand_cycle(preset)
	local cycle = {}
	for _, e in ipairs(preset) do
		for _ = 1, (e.count or 1) do
			table.insert(cycle, e.ammo)
		end
	end
	return cycle
end

--------------------------------------------------------------------
-- Plan N rounds from a cycle, advancing through the preset and
-- skipping ammo types whose available stock has run out.
--   cycle      - flat preset cycle from expand_cycle()
--   start_pos  - 1-based starting index inside the cycle (continuation)
--   count      - max rounds to plan
--   stock      - mutable {sec = remaining_count} table; the helper
--                decrements each entry it consumes. Caller may pass a
--                shallow copy if it wants to preserve the original.
-- Returns:
--   planned    - array of ammo sections (length <= count)
--   next_pos   - cycle position to resume from on the next call
--                (already advanced past the last consumed slot)
-- The walk stops early if a full sweep of the cycle finds no ammo
-- with stock left.
--------------------------------------------------------------------
function plan_cycle_advance(cycle, start_pos, count, stock)
	local planned = {}
	local cycle_len = cycle and #cycle or 0
	if cycle_len == 0 or not count or count <= 0 then
		return planned, start_pos or 1
	end
	local pos = ((start_pos or 1) - 1) % cycle_len + 1
	local taken = 0
	while taken < count do
		local round_taken = false
		for _ = 1, cycle_len do
			local ammo = cycle[pos]
			local remaining = stock and stock[ammo] or 0
			if remaining and remaining > 0 then
				table.insert(planned, ammo)
				if stock then stock[ammo] = remaining - 1 end
				pos = (pos % cycle_len) + 1
				taken = taken + 1
				round_taken = true
				break
			end
			pos = (pos % cycle_len) + 1
		end
		if not round_taken then break end
	end
	return planned, pos
end

--------------------------------------------------------------------
-- "Loaded N rounds" tip: first line = total; optional coloured lines
-- with per-ammo-type counts (one orange block, "\\n" between rows).
--------------------------------------------------------------------

--------------------------------------------------------------------
-- News tip line break + colour tokens (shared by zarządka tip and dump)
--------------------------------------------------------------------
-- Anomaly news_manager treats the two-char sequence \ + n (Lua "\\n")
-- as a line break. Real U+0A is lost in this path. For multi-line
-- coloured blocks: one %c[A,R,G,B] at the start, "\\n" between rows,
-- one %c[default] at the end (repeating %c[default]…%c[colour] per
-- row prevents the newlines from rendering).
local MSG_NL      = "\\n"
local TIP_AMBER   = "%c[255,255,200,100]"
local TIP_ORANGE  = "%c[255,255,165,70]"
local TIP_DEFAULT = "%c[default]"

-- Tally rounds in a Mags Redux mag_data.loaded array by ammo section.
-- Returns array { {sec=..., n=...}, ... } sorted alphabetically by sec.
-- Used by post-load tip, debug dump and item tooltip injector.
local function tally_loaded_sorted(loaded)
	if not loaded or #loaded == 0 then return {} end
	local t = {}
	for _, sec in ipairs(loaded) do
		t[sec] = (t[sec] or 0) + 1
	end
	local rows = {}
	for sec, n in pairs(t) do
		if n and n > 0 then
			table.insert(rows, { sec = sec, n = n })
		end
	end
	table.sort(rows, function(a, b) return a.sec < b.sec end)
	return rows
end

-- Same shape as tally_loaded_sorted, but takes a {sec=count} map.
local function tally_map_sorted(map)
	if not map then return {} end
	local rows = {}
	for sec, n in pairs(map) do
		if n and n > 0 then
			table.insert(rows, { sec = sec, n = n })
		end
	end
	table.sort(rows, function(a, b) return a.sec < b.sec end)
	return rows
end

local function build_loaded_rounds_tip_text(total, tally_by_sec)
	local first = string.format(game.translate_string("st_seqload_loaded"), tostring(total))
	local rows = tally_map_sorted(tally_by_sec)
	if #rows == 0 then
		return first
	end
	local row_fmt = game.translate_string("st_seqload_dump_round")
	local body_lines = {}
	for _, e in ipairs(rows) do
		local nm = game.translate_string(ui_item.get_sec_name(e.sec))
		table.insert(body_lines, string.format(row_fmt, nm, e.n))
	end
	local block = TIP_AMBER .. table.concat(body_lines, MSG_NL) .. TIP_DEFAULT
	return first .. MSG_NL .. block
end

-- Same as Mags Redux per-round loader: forces item tooltip / counts to update now.
-- timed_refresh() debounces ~0.5s and is not enough for instant load or final tick.
local function refresh_mags_inventory_info()
	if magazines and magazines.inventory_refresh then
		magazines.inventory_refresh(2)
	end
end

--------------------------------------------------------------------
-- Instant loading --------------------------------------------------
--------------------------------------------------------------------

local function perform_instant_load(mag, preset, mag_data, free)
	local types = {}
	for _, e in ipairs(preset) do
		table.insert(types, e.ammo)
	end
	local inv = collect_ammo_inventory(types)

	local any_ammo = false
	for _, pool in pairs(inv) do
		if pool.total > 0 then any_ammo = true break end
	end
	if not any_ammo then
		news_manager.send_tip(db.actor, game.translate_string("st_seqload_no_ammo"),
			nil, "swiss_knife", 4000)
		return
	end

	local cycle = expand_cycle(preset)
	local cycle_len = #cycle
	if cycle_len == 0 then return end

	-- Plan the full load in one pass: skip exhausted types and keep
	-- going with whatever is still in inventory (e.g. 20+20+15 of 60).
	local stock = {}
	for ammo, pool in pairs(inv) do stock[ammo] = pool.total end
	local planned = plan_cycle_advance(cycle, 1, free, stock)
	local loaded = 0
	local loaded_by = {}
	for _, ammo in ipairs(planned) do
		local pool = inv[ammo]
		if pool and take_one_round(pool) then
			stack.push(mag_data.loaded, ammo)
			loaded = loaded + 1
			loaded_by[ammo] = (loaded_by[ammo] or 0) + 1
		end
	end

	if loaded > 0 then
		magazine_binder.set_data(mag:id(), mag_data)
		if xr_sound and xr_sound.set_sound_play then
			xr_sound.set_sound_play(AC_ID, "reload_shell")
		end
		refresh_mags_inventory_info()
		if tip_after_load_enabled() then
			news_manager.send_tip(db.actor,
				build_loaded_rounds_tip_text(loaded, loaded_by),
				nil, "swiss_knife", 4000)
		end
	end
end

--------------------------------------------------------------------
-- Gradual loading (one round per tick with delay) ------------------
--------------------------------------------------------------------

local NS = "seqload"
-- Active gradual loads, keyed by mag id.
-- Shape: { cycle, cycle_pos, inv, mag_id, max_size, delay_ms,
--          last_tick, loaded, by_type, inventory_closed, ev_name }
local in_progress = {}

local function finalize(mag_id, reason)
	local state = in_progress[mag_id]
	in_progress[mag_id] = nil
	-- Release Mags Redux action state only if we set it. Using the public
	-- "interrupt" helper is safe even if state was reset by something else.
	if magazines and magazines.do_interrupt_magload then
		magazines.do_interrupt_magload()
	end
	-- Single inventory_refresh(2) is enough; we don't chain timed_refresh()
	-- because the immediate refresh already updates the magazine counter.
	refresh_mags_inventory_info()
	if not state then return end

	local show_summary = tip_after_load_enabled()
	if reason == "done" or reason == "exhausted" then
		if state.loaded > 0 then
			if show_summary then
				news_manager.send_tip(db.actor,
					build_loaded_rounds_tip_text(state.loaded, state.by_type),
					nil, "swiss_knife", 4000)
			end
		elseif reason == "exhausted" then
			-- "no ammo" is a status, not a per-load summary — always shown.
			news_manager.send_tip(db.actor, game.translate_string("st_seqload_no_ammo"),
				nil, "swiss_knife", 4000)
		end
	elseif reason == "cancelled" then
		if state.loaded > 0 then
			if show_summary then
				news_manager.send_tip(db.actor,
					build_loaded_rounds_tip_text(state.loaded, state.by_type),
					nil, "swiss_knife", 4000)
			end
		else
			-- "interrupted with 0 rounds" is a status — always shown.
			news_manager.send_tip(db.actor, game.translate_string("st_seqload_interrupted"),
				nil, "swiss_knife", 3000)
		end
	end
end

-- Re-scan actor inventory into the cached pools (after a type runs out).
local function refresh_inv_pools(inv)
	if not db.actor then return end
	for _, pool in pairs(inv) do
		pool.total = 0
		pool.boxes = {}
	end
	db.actor:iterate_inventory(function(_, item)
		local sec = item:section()
		local pool = inv[sec]
		if pool then
			table.insert(pool.boxes, item)
			pool.total = pool.total + (item:ammo_get_count() or 0)
		end
	end)
end

-- Try to load exactly one round; skip depleted preset types via plan_cycle_advance.
local function try_load_one_from_cycle(state, mag_id, mag_data)
	local cycle = state.cycle
	if not cycle or #cycle == 0 then return false end

	local stock = {}
	for ammo, pool in pairs(state.inv) do
		stock[ammo] = pool.total
	end
	local planned, next_pos = plan_cycle_advance(cycle, state.cycle_pos, 1, stock)
	if #planned == 0 then return false end

	state.cycle_pos = next_pos
	local ammo = planned[1]
	local pool = state.inv[ammo]
	if pool and pool.total > 0 and take_one_round(pool) then
		stack.push(mag_data.loaded, ammo)
		magazine_binder.set_data(mag_id, mag_data)
		state.loaded = state.loaded + 1
		state.by_type[ammo] = (state.by_type[ammo] or 0) + 1
		if utils_obj and utils_obj.play_sound then
			utils_obj.play_sound("magazines\\ammo_load" .. math.random(1, 7))
		end
		if magazines and magazines.inventory_refresh then
			magazines.inventory_refresh(2)
		end
		return true
	end
	return false
end

local function gradual_tick(mag_id)
	local state = in_progress[mag_id]
	if not state then return true end

	-- Cancellation 1: inventory closed.
	if state.inventory_closed then
		finalize(mag_id, "cancelled")
		return true
	end

	-- Cancellation 2: mag no longer in player inventory (sold / dropped / given away).
	local mag = level.object_by_id(mag_id)
	if not mag then
		finalize(mag_id, "cancelled")
		return true
	end
	local parent = mag:parent()
	if not parent or parent:id() ~= AC_ID then
		finalize(mag_id, "cancelled")
		return true
	end

	-- Cancellation 3: losing Mags Redux action state (often caused by our
	-- own take_one_round emptying a box). Re-claim the slot and continue.
	if magazines and magazines.action_in_progress and not magazines.action_in_progress() then
		if magazines.action_start_magload then
			magazines.action_start_magload()
		else
			finalize(mag_id, "cancelled")
			return true
		end
	end

	-- Full: done.
	local mag_data = magazine_binder.get_data(mag_id)
	if not mag_data then
		finalize(mag_id, "cancelled")
		return true
	end
	if #mag_data.loaded >= state.max_size then
		finalize(mag_id, "done")
		return true
	end

	-- Rate limit: only act every delay_ms.
	local tg = time_global()
	if tg < state.last_tick + state.delay_ms then return false end
	state.last_tick = tg

	-- Rescan inventory each tick so a depleted box does not stall the cycle.
	refresh_inv_pools(state.inv)

	if try_load_one_from_cycle(state, mag_id, mag_data) then
		return false
	end

	-- One type may have just run out; rescan again before giving up.
	refresh_inv_pools(state.inv)
	if try_load_one_from_cycle(state, mag_id, mag_data) then
		return false
	end

	finalize(mag_id, "exhausted")
	return true
end

local function perform_gradual_load(mag, preset, mag_data, free)
	local mag_id = mag:id()

	-- Don't double-schedule.
	if in_progress[mag_id] then return end

	local types = {}
	for _, e in ipairs(preset) do
		table.insert(types, e.ammo)
	end
	local inv = collect_ammo_inventory(types)

	local any_ammo = false
	for _, pool in pairs(inv) do
		if pool.total > 0 then any_ammo = true break end
	end
	if not any_ammo then
		news_manager.send_tip(db.actor, game.translate_string("st_seqload_no_ammo"),
			nil, "swiss_knife", 4000)
		return
	end

	local cycle = expand_cycle(preset)
	if #cycle == 0 then return end

	-- Resolve per-round delay from Mags Redux MCM.
	local delay_s = 0.4
	if magazines and magazines.get_mag_time then
		delay_s = magazines.get_mag_time(mag:section(), false) or 0.4
	end

	local max_size = SYS_GetParam(2, mag:section(), "max_mag_size") or 0

	in_progress[mag_id] = {
		cycle             = cycle,
		cycle_pos         = 1,
		inv               = inv,
		mag_id            = mag_id,
		max_size          = max_size,
		delay_ms          = (delay_s or 0.4) * 1000,
		last_tick         = 0,
		loaded            = 0,
		by_type           = {},
		inventory_closed  = false,
	}

	-- Claim Mags Redux action slot so drag-drop loads get rejected
	-- (and, importantly, so we can detect the drag as an interrupt).
	if magazines and magazines.action_start_magload then
		magazines.action_start_magload()
	end

	local ev_name = "seqload_" .. mag_id
	RemoveTimeEvent(NS, ev_name)
	CreateTimeEvent(NS, ev_name, 0.1, function()
		return gradual_tick(mag_id)
	end)
end

--------------------------------------------------------------------
-- Main entry point -------------------------------------------------
--------------------------------------------------------------------

function perform_sequential_load(mag)
	if not (magazine_binder and magazine_binder.is_magazine and magazine_binder.is_magazine(mag)) then
		return
	end

	-- Sanity: gradual load only makes sense for mags in the actor's inventory.
	-- (Context-menu gating already restricts to actor_bag/equ/belt, this is
	-- just a defence-in-depth check.)
	local parent = mag:parent()
	if not parent or parent:id() ~= AC_ID then return end

	local mag_id = mag:id()

	-- If a gradual load is already running on this mag, ignore further clicks.
	if in_progress[mag_id] then return end

	local mag_data = magazine_binder.get_data(mag_id)
	if not mag_data then return end

	local max_size = SYS_GetParam(2, mag:section(), "max_mag_size") or 0
	local free = max_size - #mag_data.loaded
	if free <= 0 then
		news_manager.send_tip(db.actor, game.translate_string("st_seqload_mag_full"),
			nil, "swiss_knife", 4000)
		return
	end

	-- Resolve preset.
	local caliber = get_mag_caliber(mag)
	local preset = filter_preset_for_mag(caliber and presets[caliber], mag)
	if #preset == 0 then
		preset = build_default_preset(mag)
	end
	if #preset == 0 then return end

	if instant_enabled() then
		perform_instant_load(mag, preset, mag_data, free)
	else
		perform_gradual_load(mag, preset, mag_data, free)
	end
end

--------------------------------------------------------------------
-- Debug dump: show current magazine round order -------------------
--------------------------------------------------------------------

-- Max number of run-length groups to print before truncating.
local DUMP_MAX_ROWS = 10

-- Resolve loaded-round array from mag_data or a plain stack table.
local function resolve_loaded_stack(src)
	if not src then return nil end
	if src.loaded then return src.loaded end
	if #src > 0 then return src end
	return nil
end

local function engine_round_count(wpn, loaded)
	if wpn and type(wpn.get_ammo_in_magazine) == "function" then
		return wpn:get_ammo_in_magazine() or 0
	end
	return loaded and #loaded or 0
end

-- Build dump text: header, grouped order list, per-type tally.
-- src = mag_data table or plain loaded stack array.
-- Optional wpn: live weapon object for accurate round count in the dump.
function build_dump_text(header, src, wpn)
	local lines = {header}

	local loaded = resolve_loaded_stack(src)
	if not loaded or #loaded == 0 then
		table.insert(lines, game.translate_string("st_seqload_dump_empty"))
		return table.concat(lines, MSG_NL)
	end

	local total = engine_round_count(wpn, loaded)
	local display_len = math.min(#loaded, total > 0 and total or #loaded)

	local row_fmt = game.translate_string("st_seqload_dump_round")
	local groups = 0
	local i = display_len
	while i >= 1 and groups < DUMP_MAX_ROWS do
		local sec = loaded[i]
		local count = 0
		while i >= 1 and loaded[i] == sec do
			count = count + 1
			i = i - 1
		end
		local name = game.translate_string(ui_item.get_sec_name(sec))
		table.insert(lines, string.format(row_fmt, name, count))
		groups = groups + 1
	end

	if i >= 1 then
		table.insert(lines, game.translate_string("st_seqload_dump_more"))
	end

	-- Per-type totals for rounds currently in the weapon.
	local tally_src = {}
	for j = 1, display_len do
		tally_src[j] = loaded[j]
	end
	local tally_rows = tally_loaded_sorted(tally_src)
	if #tally_rows > 0 then
		local rem_head = game.translate_string("st_seqload_dump_remainder_header")
		local rem_lines = { rem_head }
		for _, e in ipairs(tally_rows) do
			local nm = game.translate_string(ui_item.get_sec_name(e.sec))
			table.insert(rem_lines, string.format(row_fmt, nm, e.n))
		end
		table.insert(lines, TIP_AMBER .. table.concat(rem_lines, MSG_NL) .. TIP_DEFAULT)
	end

	return table.concat(lines, MSG_NL)
end

-- Public: dump for a magazine under cursor / in inventory.
function dump_mag_order(mag)
	if not (magazine_binder and magazine_binder.is_magazine and magazine_binder.is_magazine(mag)) then
		return
	end
	local header = game.translate_string(ui_item.get_sec_name(mag:section()))
	local mag_data = magazine_binder.get_data(mag:id())
	local text = build_dump_text(header, mag_data)
	news_manager.send_tip(db.actor, text, nil, "swiss_knife", 8000)
end

-- Public: dump for the magazine currently attached to a weapon in hand.
function dump_weapon_mag(wpn)
	if not wpn then return end
	if not (magazine_binder and magazine_binder.is_supported_weapon
		and magazine_binder.is_supported_weapon(wpn)) then
		return
	end
	local header = game.translate_string(ui_item.get_sec_name(wpn:section()))
	local mag_data = magazine_binder.get_mag_loaded(wpn:id())
	if not mag_data then
		local text = header .. MSG_NL .. game.translate_string("st_seqload_dump_no_mag")
		news_manager.send_tip(db.actor, text, nil, "swiss_knife", 6000)
		return
	end
	local text = build_dump_text(header, mag_data, wpn)
	news_manager.send_tip(db.actor, text, nil, "swiss_knife", 8000)
end

--------------------------------------------------------------------
-- Interrupt hook: inventory close ---------------------------------
--------------------------------------------------------------------

local function on_gui_hide(name, path)
	if name ~= "UIInventory" then return end
	-- Flag all active gradual loads; actual cleanup happens on next tick.
	for _, state in pairs(in_progress) do
		state.inventory_closed = true
	end
end

--------------------------------------------------------------------
-- Magazine context-menu functor ------------------------------------
--------------------------------------------------------------------

local MENU_MODES = {inventory = true, loot = true}
local MENU_BAGS  = {actor_bag = true, actor_equ = true, actor_belt = true}

local function menu_check(obj, bag, mode)
	if not magazine_binder then return false end
	if not (MENU_MODES[mode] and MENU_BAGS[bag]) then return false end
	if not magazine_binder.is_magazine(obj) then return false end
	local parent = obj:parent()
	if not parent or parent:id() ~= AC_ID then return false end
	local mag_data = magazine_binder.get_data(obj:id())
	if not mag_data then return false end
	local max_size = SYS_GetParam(2, obj:section(), "max_mag_size") or 0
	if #mag_data.loaded >= max_size then return false end
	-- Don't show a second time if we're already loading this mag.
	if in_progress[obj:id()] then return false end
	return true
end

local function menu_str(obj, bag, mode)
	return "st_seqload_menu"
end

local function menu_action(obj, bag, mode)
	perform_sequential_load(obj)
end

--------------------------------------------------------------------
-- Magazine tooltip: "Type:" + per-ammo tallies (for zzz tooltips hook)
--------------------------------------------------------------------

function get_mag_ammo_type_tooltip_block(mag_data)
	if not (mag_data and mag_data.loaded and #mag_data.loaded > 0) then
		return nil
	end
	if not (utils_xml and utils_xml.get_color and ui_item) then
		return nil
	end
	local rows = tally_loaded_sorted(mag_data.loaded)
	if #rows == 0 then
		return nil
	end
	local clr_g = utils_xml.get_color("d_green")
	local clr_2 = utils_xml.get_color("ui_gray_1")
	if not (clr_g and clr_2) then
		return nil
	end
	local hdr = game.translate_string("st_seqload_tooltip_type_header")
	-- After clr_g the colour stays active; reset with clr_2 (same pattern as
	-- st_mag_ammo_loaded_count line in mags_patches).
	local parts = { clr_2 .. hdr .. " \\n" }
	for _, e in ipairs(rows) do
		local nm = game.translate_string(ui_item.get_sec_short_name(e.sec))
		table.insert(parts,
			clr_2 .. nm .. " - " .. clr_g .. tostring(e.n) .. "x" .. clr_2 .. " \\n")
	end
	return table.concat(parts, "")
end

--------------------------------------------------------------------
-- Lifecycle --------------------------------------------------------
--------------------------------------------------------------------

function on_game_start()
	-- Preset persistence and inventory-close interrupt are useful even
	-- without Mags Redux: the internal-mag (non-magazine) loader uses
	-- the same preset table, and its UI editor also needs save/load.
	RegisterScriptCallback("save_state",  save_state)
	RegisterScriptCallback("load_state",  load_state)
	RegisterScriptCallback("GUI_on_hide", on_gui_hide)
	RegisterScriptCallback("actor_on_first_update", reset_caliber_cache)

	if not magazine_binder then
		printf("Sequential Load: Anomaly Magazines Redux not found, magazine mode disabled (internal-mag mode still works)")
		return
	end
	if not (custom_functor_autoinject and custom_functor_autoinject.add_functor) then
		printf("Sequential Load: custom_functor_autoinject not found, menu entry disabled")
	else
		custom_functor_autoinject.add_functor("seqload_magazine",
			menu_check, menu_str, nil, menu_action, true)
	end
end
